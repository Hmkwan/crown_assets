# 定时任务配置示例
# 复制此文件为 .env 并根据需要修改

# 全局开关 - 是否启用定时任务调度器
SCHEDULER_ENABLED=true

# 单个任务开关
# 保养计划提醒 (每天早上8:00)
SCHEDULER_MAINTENANCE_DUE=true

# 逾期借用检查 (每天早上9:00)
SCHEDULER_OVERDUE_LOANS=true

# 即将到期借用提醒 (每天早上9:00)
SCHEDULER_UPCOMING_RETURNS=true

# 待验收归还检查 (每天早上10:00)
SCHEDULER_PENDING_INSPECTIONS=true

# 审批待办提醒 (每天上午10:30和下午15:00)
SCHEDULER_PENDING_APPROVALS=true

# 如果需要禁用某个任务,将对应值改为 false
# 例如:
# SCHEDULER_MAINTENANCE_DUE=false
